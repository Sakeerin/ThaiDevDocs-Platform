{
  "name": "thaidevdocs-platform",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "start": "next start",
    "types:check": "fumadocs-mdx && next typegen && tsc --noEmit",
    "postinstall": "fumadocs-mdx",
    "lint": "eslint",
    "content:validate": "node scripts/validate-frontmatter.mjs",
    "content:stale": "node scripts/check-stale-content.mjs",
    "content:qa": "node scripts/content-qa.mjs",
    "content:fix-fences": "node scripts/fix-code-fence-languages.mjs",
    "content:check": "npm run content:validate && npm run content:stale && npm run content:qa",
    "smoke:test": "node scripts/smoke-test.mjs",
    "verify:production": "node scripts/verify-production-env.mjs",
    "lighthouse:audit": "node scripts/lighthouse-audit.mjs",
    "newsletter:weekly": "node scripts/send-weekly-newsletter.mjs",
    "sponsor:inquiries": "node scripts/list-sponsor-inquiries.mjs",
    "vercel:pull": "npx vercel pull --yes --environment=preview",
    "deploy:staging": "npx vercel deploy --yes"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.85",
    "@ai-sdk/openai": "^3.0.73",
    "@ai-sdk/react": "^3.0.210",
